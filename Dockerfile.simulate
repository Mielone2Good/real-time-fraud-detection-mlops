FROM python:3.11-slim

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY simulate_transactions_stream ./simulate_transactions_stream
COPY data ./data

ENV PYTHONPATH=/app

# CSV path: /app/data/raw_data/creditcard.csv (set via env or default in code)
CMD ["python", "simulate_transactions_stream/kafka_stream.py"]
